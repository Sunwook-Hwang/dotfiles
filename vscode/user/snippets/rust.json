{
  "Fallible main": {
    "prefix": "mainresult",
    "body": [
      "fn main() -> Result<(), Box<dyn std::error::Error>> {",
      "\t$0",
      "\tOk(())",
      "}"
    ],
    "description": "Main returning a standard error result"
  },
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:}) -> ${3:()} {", "\t$0", "}"],
    "description": "Function declaration"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Record} {", "\t${2:value}: ${3:i32},", "\t$0", "}"],
    "description": "Struct with a field"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:State} {",
      "\t${2:Ready},",
      "\t${3:Failed}(String),",
      "\t$0",
      "}"
    ],
    "description": "Enum with unit and tuple variants"
  },
  "Implementation": {
    "prefix": "impl",
    "body": ["impl ${1:Type} {", "\t$0", "}"],
    "description": "Inherent implementation"
  },
  "Trait": {
    "prefix": "trait",
    "body": ["trait ${1:Behavior} {", "\tfn ${2:run}(&self);", "\t$0", "}"],
    "description": "Trait declaration"
  },
  "Unit test": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:behavior}() {",
      "\tassert_eq!(${2:1}, ${3:1});",
      "\t$0",
      "}"
    ],
    "description": "Unit test"
  },
  "Test module": {
    "prefix": "tests",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "\tuse super::*;",
      "",
      "\t#[test]",
      "\tfn ${1:behavior}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Test-only module"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} => ${3:result},",
      "\t_ => ${4:default},",
      "}$0"
    ],
    "description": "Match expression with a fallback arm"
  }
}
