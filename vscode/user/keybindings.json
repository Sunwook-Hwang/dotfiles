// VS Code actions and widget navigation live here; Vim editing sequences live in settings.json.
[
  // Leader menu; Insert mode and input widgets keep their normal Space key.
  {
    "key": "space",
    "command": "whichkey.show",
    "when": "editorTextFocus && vim.active && (vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine' || vim.mode == 'VisualBlock') && !whichkeyActive && !suggestWidgetVisible"
  },

  // Outline visibility is supplied to Which Key when its "o" binding is selected.
  {
    "key": "o",
    "command": "whichkey.triggerKey",
    "args": "o",
    "when": "whichkeyVisible"
  },
  {
    "key": "o",
    "command": "whichkey.triggerKey",
    "args": { "key": "o", "when": "outlineVisible" },
    "when": "whichkeyVisible && view.outline.visible"
  },

  // Relay editor-action visibility to the Te toggle in Which Key.
  {
    "key": "e",
    "command": "whichkey.triggerKey",
    "args": "e",
    "when": "whichkeyVisible"
  },
  {
    "key": "e",
    "command": "whichkey.triggerKey",
    "args": { "key": "e", "when": "editorActionsVisible" },
    "when": "whichkeyVisible && config.workbench.editor.editorActionsLocation != 'hidden'"
  },

  // VS Code actions in Vim Normal mode.
  {
    "key": "shift+h",
    "command": "workbench.action.previousEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible"
  },
  {
    "key": "shift+l",
    "command": "workbench.action.nextEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible"
  },
  {
    "key": "shift+;",
    "command": "vim.showQuickpickCmdLine",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible"
  },
  {
    "key": "shift+k",
    "command": "editor.action.showHover",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible"
  },
  {
    "key": "alt+,",
    "command": "workbench.action.previousEditor",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible"
  },
  {
    "key": "alt+.",
    "command": "workbench.action.nextEditor",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible"
  },

  // Explorer navigation must not intercept file-name input.
  { "key": "ctrl+shift+e", "command": "actions.findWithSelection" },
  { "key": "ctrl+e", "command": "workbench.view.explorer" },
  {
    "key": "r",
    "command": "renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly"
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "l",
    "command": "list.select",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "o",
    "command": "list.toggleExpand",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && !inputFocus"
  },

  // Sidebar inputs allow pane navigation; pickers and completion lists keep priority.
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "!inQuickOpen && !suggestWidgetVisible && (!inputFocus || editorTextFocus || terminalFocus || sideBarFocus || auxiliaryBarFocus)"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "!inQuickOpen && !suggestWidgetVisible && (!inputFocus || editorTextFocus || terminalFocus || sideBarFocus || auxiliaryBarFocus)"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "!inQuickOpen && !suggestWidgetVisible && (!inputFocus || editorTextFocus || terminalFocus || sideBarFocus || auxiliaryBarFocus)"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "!inQuickOpen && !suggestWidgetVisible && (!inputFocus || editorTextFocus || terminalFocus || sideBarFocus || auxiliaryBarFocus)"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "sideBarFocus && !inQuickOpen && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus && !inQuickOpen"
  },
  {
    "key": "alt+j",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus && !inQuickOpen"
  },

  // Codex and Claude Code sidebar webviews do not report native pane focus.
  // Return toward the editor; editor-tab webviews keep normal directional navigation.
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorAreaFocus && !editorFocus && !terminalFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !inputFocus && !listFocus && !inQuickOpen && !suggestWidgetVisible && ((auxiliaryBarVisible && activeAuxiliary =~ /^workbench\\.view\\.extension\\.(codexViewContainer|codexSecondaryViewContainer|claude-sidebar|claude-sidebar-secondary)$/ && config.workbench.sideBar.location != right) || (sideBarVisible && activeViewlet =~ /^workbench\\.view\\.extension\\.(codexViewContainer|codexSecondaryViewContainer|claude-sidebar|claude-sidebar-secondary)$/ && config.workbench.sideBar.location == right))"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorAreaFocus && !editorFocus && !terminalFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !inputFocus && !listFocus && !inQuickOpen && !suggestWidgetVisible && ((sideBarVisible && activeViewlet =~ /^workbench\\.view\\.extension\\.(codexViewContainer|codexSecondaryViewContainer|claude-sidebar|claude-sidebar-secondary)$/ && config.workbench.sideBar.location != right) || (auxiliaryBarVisible && activeAuxiliary =~ /^workbench\\.view\\.extension\\.(codexViewContainer|codexSecondaryViewContainer|claude-sidebar|claude-sidebar-secondary)$/ && config.workbench.sideBar.location == right))"
  },

  // Ctrl-n/p fallback for plain inputs and focused lists.
  {
    "key": "ctrl+n",
    "command": "cursorDown",
    "when": "textInputFocus && !inQuickOpen && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+p",
    "command": "cursorUp",
    "when": "textInputFocus && !inQuickOpen && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+n",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "ctrl+n",
    "command": "search.action.focusSearchList",
    "when": "searchViewletFocus && inputFocus && !inQuickOpen && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+p",
    "command": "search.action.focusSearchFromResults",
    "when": "searchViewletFocus && (firstMatchFocus || !fileMatchOrMatchFocus) && listFocus && !inputFocus && !inQuickOpen"
  },

  // Leave the commit message editor for the SCM resource list.
  {
    "key": "ctrl+n",
    "command": "workbench.scm.action.focusNextResourceGroup",
    "when": "scmRepository && inputFocus && !inQuickOpen && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.scm.action.focusPreviousResourceGroup",
    "when": "scmRepository && inputFocus && !inQuickOpen && !suggestWidgetVisible"
  },

  // Parameter hints are used only when no completion list is open.
  {
    "key": "ctrl+n",
    "command": "showNextParameterHint",
    "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible && !suggestWidgetVisible && !inQuickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "showPrevParameterHint",
    "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible && !suggestWidgetVisible && !inQuickOpen"
  },

  // Quick Open and which-key pickers own their navigation keys.
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "tab",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "shift+tab",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },

  // Completion navigation takes precedence over pane navigation and parameter hints.
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "textInputFocus && suggestWidgetVisible && !inQuickOpen"
  },
  {
    "key": "ctrl+n",
    "command": "selectNextSuggestion",
    "when": "textInputFocus && suggestWidgetVisible && !inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "textInputFocus && suggestWidgetVisible && !inQuickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "selectPrevSuggestion",
    "when": "textInputFocus && suggestWidgetVisible && !inQuickOpen"
  },
  {
    "key": "tab",
    "command": "selectNextSuggestion",
    "when": "textInputFocus && suggestWidgetVisible && !inQuickOpen && suggestWidgetMultipleSuggestions"
  },
  {
    "key": "shift+tab",
    "command": "selectPrevSuggestion",
    "when": "textInputFocus && suggestWidgetVisible && !inQuickOpen && suggestWidgetMultipleSuggestions"
  },
  {
    "key": "tab",
    "command": "editor.action.inlineSuggest.commit",
    "when": "textInputFocus && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorTabMovesFocus && !suggestWidgetVisible && !inQuickOpen"
  },

  // Keep files open in one editor group; no hidden splits or Zen Mode.
  {
    "key": "ctrl+w o",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeSidebar",
        "workbench.action.closeAuxiliaryBar",
        "workbench.action.closePanel",
        "workbench.action.joinAllGroups"
      ]
    },
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive"
  },

  // Terminal, save and layout shortcuts.
  { "key": "ctrl+t", "command": "workbench.action.terminal.toggleTerminal" },
  { "key": "ctrl+\\", "command": "workbench.action.toggleMaximizedPanel" },
  { "key": "ctrl+s", "command": "workbench.action.files.save" },
  // Resize the focused view; use separate axes inside the editor area.
  { "key": "ctrl+shift+left", "command": "workbench.action.decreaseViewSize" },
  { "key": "ctrl+shift+right", "command": "workbench.action.increaseViewSize" },
  { "key": "ctrl+shift+up", "command": "workbench.action.decreaseViewSize" },
  { "key": "ctrl+shift+down", "command": "workbench.action.increaseViewSize" },
  {
    "key": "ctrl+shift+left",
    "command": "workbench.action.decreaseViewWidth",
    "when": "editorAreaFocus"
  },
  {
    "key": "ctrl+shift+right",
    "command": "workbench.action.increaseViewWidth",
    "when": "editorAreaFocus"
  },
  {
    "key": "ctrl+shift+up",
    "command": "workbench.action.decreaseViewHeight",
    "when": "editorAreaFocus"
  },
  {
    "key": "ctrl+shift+down",
    "command": "workbench.action.increaseViewHeight",
    "when": "editorAreaFocus"
  },
  // Open Codex specifically; hide the right sidebar only while Codex is visible.
  { "key": "ctrl+shift+t", "command": "chatgpt.openSidebar" },
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.closeAuxiliaryBar",
    "when": "view.chatgpt.sidebarSecondaryView.visible"
  },

  // Retain existing removals of conflicting default shortcuts.
  { "key": "ctrl+e", "command": "-actions.findWithSelection" },
  { "key": "shift+ctrl+e", "command": "-workbench.view.explorer" },
  {
    "key": "enter",
    "command": "-renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  { "key": "ctrl+j", "command": "-workbench.action.togglePanel" },
  {
    "key": "ctrl+k ctrl+i",
    "command": "-editor.action.showHover",
    "when": "editorTextFocus"
  },
  { "key": "ctrl+n", "command": "-workbench.action.files.newUntitledFile" },
  { "key": "ctrl+p", "command": "-workbench.action.quickOpen" },
  {
    "key": "ctrl+down",
    "command": "-selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "alt+down",
    "command": "-showNextParameterHint",
    "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible"
  },
  { "key": "alt+cmd+b", "command": "-workbench.action.toggleAuxiliaryBar" },
  {
    "key": "shift+tab",
    "command": "-acceptAlternativeSelectedSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  }
]
