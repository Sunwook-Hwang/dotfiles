{
  "name": "FLASH",
  "settings": "{\"settings\": \"{\\n  // Settings Sync and extensions\\n  \\\"settingsSync.keybindingsPerPlatform\\\": false,\\n  \\\"extensions.ignoreRecommendations\\\": false,\\n  \\\"extensions.experimental.affinity\\\": {\\n    \\\"vscodevim.vim\\\": 1\\n  },\\n  \\\"redhat.telemetry.enabled\\\": false,\\n\\n  // Workbench appearance and layout\\n  \\\"workbench.activityBar.location\\\": \\\"default\\\",\\n  \\\"breadcrumbs.enabled\\\": true,\\n  \\\"workbench.editor.enablePreview\\\": false,\\n  \\\"workbench.startupEditor\\\": \\\"newUntitledFile\\\",\\n  \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n  \\\"window.commandCenter\\\": false,\\n  \\\"window.titleBarStyle\\\": \\\"native\\\",\\n  \\\"window.customTitleBarVisibility\\\": \\\"never\\\",\\n  \\\"workbench.editorAssociations\\\": {\\n    \\\"*.copilotmd\\\": \\\"vscode.markdown.preview.editor\\\",\\n    \\\"*.pdf\\\": \\\"latex-workshop-pdf-hook\\\",\\n    \\\"*.ipynb\\\": \\\"jupyter-notebook\\\",\\n    \\\"*.o\\\": \\\"default\\\"\\n  },\\n  \\\"workbench.colorCustomizations\\\": {\\n    \\\"editorWarning.foreground\\\": \\\"#00000000\\\"\\n  },\\n  \\\"zenMode.centerLayout\\\": false,\\n  \\\"zenMode.hideStatusBar\\\": false,\\n  \\\"zenMode.showTabs\\\": \\\"single\\\",\\n  \\\"zenMode.hideLineNumbers\\\": false,\\n  \\\"vsicons.dontShowNewVersionMessage\\\": true,\\n  \\\"window.newWindowProfile\\\": \\\"Default\\\",\\n  \\\"workbench.editor.editorActionsLocation\\\": \\\"hidden\\\",\\n  \\\"workbench.colorTheme\\\": \\\"One Dark Pro Night Flat\\\",\\n  \\\"workbench.iconTheme\\\": \\\"vscode-modern-icons\\\",\\n\\n  // Editor appearance and behavior\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"editor.stickyScroll.defaultModel\\\": \\\"indentationModel\\\",\\n  \\\"editor.stickyScroll.maxLineCount\\\": 8,\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"editor.cursorBlinking\\\": \\\"solid\\\",\\n  \\\"editor.cursorSurroundingLines\\\": 5,\\n  \\\"editor.detectIndentation\\\": false,\\n  \\\"editor.fontFamily\\\": \\\"Roboto Mono, JetBrainsMono Nerd Font Mono, Roboto Mono NF, CaskaydiaCove Nerd Font Mono, JetBrains Mono\\\",\\n  \\\"editor.fontSize\\\": 13,\\n  \\\"editor.lineHeight\\\": 0,\\n  \\\"editor.insertSpaces\\\": true,\\n  \\\"editor.renderLineHighlight\\\": \\\"all\\\",\\n  \\\"editor.mouseWheelZoom\\\": false,\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n  \\\"editor.scrollbar.horizontal\\\": \\\"hidden\\\",\\n  \\\"editor.scrollbar.vertical\\\": \\\"hidden\\\",\\n  \\\"editor.unicodeHighlight.invisibleCharacters\\\": true,\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"editor.lineNumbers\\\": \\\"on\\\",\\n\\n  // Completion and suggestions\\n  \\\"editor.inlineSuggest.enabled\\\": false,\\n  \\\"editor.acceptSuggestionOnEnter\\\": \\\"off\\\",\\n  \\\"editor.suggestSelection\\\": \\\"first\\\",\\n  \\\"editor.snippetSuggestions\\\": \\\"none\\\",\\n  \\\"editor.quickSuggestions\\\": {\\n    \\\"other\\\": \\\"off\\\",\\n    \\\"comments\\\": \\\"off\\\",\\n    \\\"strings\\\": \\\"off\\\"\\n  },\\n  \\\"editor.suggestOnTriggerCharacters\\\": false,\\n  \\\"editor.wordBasedSuggestions\\\": \\\"off\\\",\\n  \\\"editor.tabCompletion\\\": \\\"off\\\",\\n\\n  // Formatting\\n  \\\"editor.formatOnSave\\\": false,\\n  \\\"editor.formatOnPaste\\\": true,\\n  \\\"editor.formatOnType\\\": true,\\n  \\\"prettier.printWidth\\\": 300,\\n\\n  // Vim editing and keymaps\\n  \\\"vim.easymotion\\\": true,\\n  \\\"vim.highlightedyank.enable\\\": true,\\n  \\\"vim.hlsearch\\\": true,\\n  \\\"vim.visualstar\\\": true,\\n  \\\"vim.incsearch\\\": true,\\n  \\\"vim.leader\\\": \\\"<space>\\\",\\n  \\\"vim.sneakUseIgnorecaseAndSmartcase\\\": true,\\n  \\\"vim.useCtrlKeys\\\": true,\\n  \\\"vim.useSystemClipboard\\\": true,\\n  \\\"vim.handleKeys\\\": {\\n    \\\"<C-a>\\\": false,\\n    \\\"<C-f>\\\": false\\n  },\\n  \\\"vim.insertModeKeyBindingsNonRecursive\\\": [\\n    {\\n      \\\"before\\\": [\\\"j\\\", \\\"k\\\"],\\n      \\\"after\\\": [\\\"<Esc>\\\"]\\n    }\\n  ],\\n  \\\"vim.normalModeKeyBindingsNonRecursive\\\": [\\n    {\\n      \\\"before\\\": [\\\"n\\\"],\\n      \\\"after\\\": [\\\"n\\\", \\\"z\\\", \\\"v\\\", \\\"z\\\", \\\"z\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"N\\\"],\\n      \\\"after\\\": [\\\"N\\\", \\\"z\\\", \\\"v\\\", \\\"z\\\", \\\"z\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"f\\\"],\\n      \\\"after\\\": [\\\"leader\\\", \\\"leader\\\", \\\"2\\\", \\\"s\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"s\\\"],\\n      \\\"after\\\": [\\\"leader\\\", \\\"leader\\\", \\\"s\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"<esc>\\\"],\\n      \\\"commands\\\": [\\\":nohl\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"x\\\"],\\n      \\\"after\\\": [\\\"\\\\\\\"\\\", \\\"_\\\", \\\"x\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"Y\\\"],\\n      \\\"after\\\": [\\\"y\\\", \\\"$\\\"]\\n    }\\n  ],\\n  \\\"vim.visualModeKeyBindingsNonRecursive\\\": [\\n    {\\n      \\\"before\\\": [\\\"p\\\"],\\n      \\\"after\\\": [\\\"P\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"P\\\"],\\n      \\\"after\\\": [\\\"P\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\">\\\"],\\n      \\\"after\\\": [\\\">\\\", \\\"g\\\", \\\"v\\\"]\\n    },\\n    {\\n      \\\"before\\\": [\\\"<\\\"],\\n      \\\"after\\\": [\\\"<\\\", \\\"g\\\", \\\"v\\\"]\\n    }\\n  ],\\n\\n  // Leader menu\\n  \\\"whichkey.delay\\\": 0,\\n  \\\"whichkey.sortOrder\\\": \\\"none\\\",\\n  \\\"whichkey.bindings\\\": [\\n    {\\n      \\\"key\\\": \\\"/\\\",\\n      \\\"name\\\": \\\"Quick open\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\";\\\",\\n      \\\"name\\\": \\\"commands\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.showCommands\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"b\\\",\\n      \\\"name\\\": \\\"Buffers/Editors\\u2026\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"b\\\",\\n          \\\"name\\\": \\\"Show all buffers/editors\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.showAllEditors\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"d\\\",\\n          \\\"name\\\": \\\"Close active editor\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.closeActiveEditor\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"h\\\",\\n          \\\"name\\\": \\\"Close editors to the left\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.closeEditorsToTheLeft\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"j\\\",\\n          \\\"name\\\": \\\"Move editor left in tab order\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.moveEditorLeftInGroup\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"k\\\",\\n          \\\"name\\\": \\\"Move editor right in tab order\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.moveEditorRightInGroup\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"l\\\",\\n          \\\"name\\\": \\\"Close editors to the right\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.closeEditorsToTheRight\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"m\\\",\\n          \\\"name\\\": \\\"Close other editors\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.closeOtherEditors\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"n\\\",\\n          \\\"name\\\": \\\"Next editor\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.nextEditor\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"N\\\",\\n          \\\"name\\\": \\\"New untitled editor\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.files.newUntitledFile\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"u\\\",\\n          \\\"name\\\": \\\"Reopen closed editor\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.reopenClosedEditor\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"y\\\",\\n          \\\"name\\\": \\\"Copy buffer to clipboard\\\",\\n          \\\"type\\\": \\\"commands\\\",\\n          \\\"commands\\\": [\\n            \\\"editor.action.selectAll\\\",\\n            \\\"editor.action.clipboardCopyAction\\\",\\n            \\\"cancelSelection\\\"\\n          ]\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"c\\\",\\n      \\\"name\\\": \\\"Close active editor\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.closeActiveEditor\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"d\\\",\\n      \\\"name\\\": \\\"Debug\\u2026\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"b\\\",\\n          \\\"name\\\": \\\"Toggle breakpoint\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.debug.action.toggleBreakpoint\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"B\\\",\\n          \\\"name\\\": \\\"Toggle inline breakpoint\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.debug.action.toggleInlineBreakpoint\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"c\\\",\\n          \\\"name\\\": \\\"Continue debug\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.continue\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"d\\\",\\n          \\\"name\\\": \\\"Start debug\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.start\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"i\\\",\\n          \\\"name\\\": \\\"Step into\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.stepInto\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"j\\\",\\n          \\\"name\\\": \\\"Jump to cursor\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"debug.jumpToCursor\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"o\\\",\\n          \\\"name\\\": \\\"Step out\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.stepOut\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"p\\\",\\n          \\\"name\\\": \\\"Pause debug\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.pause\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"r\\\",\\n          \\\"name\\\": \\\"Run without debugging\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.run\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"R\\\",\\n          \\\"name\\\": \\\"Restart debug\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.restart\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Step over\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.stepOver\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"S\\\",\\n          \\\"name\\\": \\\"Stop debug\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.debug.stop\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"v\\\",\\n          \\\"name\\\": \\\"REPL\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.debug.action.toggleRepl\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"w\\\",\\n          \\\"name\\\": \\\"Focus on watch window\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.debug.action.focusWatchView\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"W\\\",\\n          \\\"name\\\": \\\"Add to watch\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.debug.action.selectionToWatch\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"e\\\",\\n      \\\"name\\\": \\\"Toggle Explorer\\\",\\n      \\\"type\\\": \\\"conditional\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"when:explorerVisible\\\",\\n          \\\"name\\\": \\\"Hide Explorer\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.closeSidebar\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"default\\\",\\n          \\\"name\\\": \\\"Show Explorer\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.view.explorer\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"f\\\",\\n      \\\"name\\\": \\\"Find project files\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"g\\\",\\n      \\\"name\\\": \\\"Git\\u2026\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"a\\\",\\n          \\\"name\\\": \\\"Stage Selected\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.stageSelectedRanges\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"A\\\",\\n          \\\"name\\\": \\\"Stage File\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.stage\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"c\\\",\\n          \\\"name\\\": \\\"Commit\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.commit\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"C\\\",\\n          \\\"name\\\": \\\"Cherry Pick\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.cherryPick\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"d\\\",\\n          \\\"name\\\": \\\"Diff\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.openChange\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"f\\\",\\n          \\\"name\\\": \\\"Fetch\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.fetch\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"F\\\",\\n          \\\"name\\\": \\\"Pull From\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.pullFrom\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"g\\\",\\n          \\\"name\\\": \\\"LazyGit\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"lazygit-vscode.toggle\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"G\\\",\\n          \\\"name\\\": \\\"Show source control\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.view.scm\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"H\\\",\\n          \\\"name\\\": \\\"History\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.viewFileHistory\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"i\\\",\\n          \\\"name\\\": \\\"Init\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.init\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"j\\\",\\n          \\\"name\\\": \\\"Next Change\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.editor.nextChange\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"k\\\",\\n          \\\"name\\\": \\\"Previous Change\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.editor.previousChange\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"l\\\",\\n          \\\"name\\\": \\\"Toggle Line Blame\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.blame.toggleEditorDecoration\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"m\\\",\\n          \\\"name\\\": \\\"Merge\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.merge\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"P\\\",\\n          \\\"name\\\": \\\"Pull\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.pull\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Stage current hunk\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.diff.stageHunk\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"S\\\",\\n          \\\"name\\\": \\\"Stage file\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.stageFile\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"t\\\",\\n          \\\"name\\\": \\\"Create Tag\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.createTag\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"T\\\",\\n          \\\"name\\\": \\\"Delete Tag\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.deleteTag\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"u\\\",\\n          \\\"name\\\": \\\"Push\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"git.push\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"l\\\",\\n      \\\"name\\\": \\\"LSP...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\";\\\",\\n          \\\"name\\\": \\\"Refactor\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.refactor\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"a\\\",\\n          \\\"name\\\": \\\"Auto Fix\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.autoFix\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"d\\\",\\n          \\\"name\\\": \\\"Line diagnostics / hover\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.showHover\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"D\\\",\\n          \\\"name\\\": \\\"Diagnostics (Problems)\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.problems.focus\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"e\\\",\\n          \\\"name\\\": \\\"Errors\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.actions.view.problems\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"f\\\",\\n          \\\"name\\\": \\\"Format\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.formatDocument\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"i\\\",\\n          \\\"name\\\": \\\"Implementation\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.goToImplementation\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"l\\\",\\n          \\\"name\\\": \\\"Code Lens\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"codelens.showLensesInCurrentLine\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"n\\\",\\n          \\\"name\\\": \\\"Next Problem\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.marker.next\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"N\\\",\\n          \\\"name\\\": \\\"Next Problem (Proj)\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.marker.nextInFiles\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"o\\\",\\n          \\\"name\\\": \\\"Outline\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"outline.focus\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"p\\\",\\n          \\\"name\\\": \\\"Prev Problem\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.marker.prev\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"P\\\",\\n          \\\"name\\\": \\\"Prev Problem (Proj)\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.marker.prevInFiles\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"q\\\",\\n          \\\"name\\\": \\\"Quick Fix\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.quickFix\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"r\\\",\\n          \\\"name\\\": \\\"Rename\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.rename\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"R\\\",\\n          \\\"name\\\": \\\"References\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"editor.action.goToReferences\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Go To Symbol\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.gotoSymbol\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"S\\\",\\n          \\\"name\\\": \\\"Show All Symbols\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.showAllSymbols\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"v\\\",\\n          \\\"name\\\": \\\"Select Python environment\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"python.setInterpreter\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"V\\\",\\n          \\\"name\\\": \\\"View All References\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"references-view.find\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"m\\\",\\n      \\\"name\\\": \\\"Mark...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"c\\\",\\n          \\\"name\\\": \\\"Clear Bookmarks\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.clear\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"j\\\",\\n          \\\"name\\\": \\\"Next Bookmark\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.jumpToNext\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"k\\\",\\n          \\\"name\\\": \\\"Previous Bookmark\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.jumpToPrevious\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"l\\\",\\n          \\\"name\\\": \\\"List Bookmarks\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.listFromAllFiles\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"m\\\",\\n          \\\"name\\\": \\\"Toggle Bookmark Label\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.toggleLabeled\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"r\\\",\\n          \\\"name\\\": \\\"Refresh Bookmarks\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.refresh\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Show Bookmarks\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.view.extension.bookmarks\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"t\\\",\\n          \\\"name\\\": \\\"Toggle Bookmark\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"bookmarks.toggle\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"M\\\",\\n      \\\"name\\\": \\\"Minimap\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"settings.cycle\\\",\\n      \\\"args\\\": {\\n        \\\"id\\\": \\\"minimap\\\",\\n        \\\"values\\\": [\\n          {\\n            \\\"editor.minimap.enabled\\\": false\\n          },\\n          {\\n            \\\"editor.minimap.enabled\\\": true\\n          }\\n        ]\\n      }\\n    },\\n    {\\n      \\\"key\\\": \\\"o\\\",\\n      \\\"name\\\": \\\"Toggle Outline\\\",\\n      \\\"type\\\": \\\"conditional\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"when:outlineVisible\\\",\\n          \\\"name\\\": \\\"Hide Outline\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.closeAuxiliaryBar\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"default\\\",\\n          \\\"name\\\": \\\"Show Outline\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"outline.focus\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"O\\\",\\n      \\\"name\\\": \\\"Open...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"d\\\",\\n          \\\"name\\\": \\\"Directory\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.files.openFolder\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"f\\\",\\n          \\\"name\\\": \\\"File\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.files.openFile\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"r\\\",\\n      \\\"name\\\": \\\"Recent Open...\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.openRecent\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"s\\\",\\n      \\\"name\\\": \\\"Search...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"b\\\",\\n          \\\"name\\\": \\\"Search buffers/editors\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.showAllEditors\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"f\\\",\\n          \\\"name\\\": \\\"Files\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"h\\\",\\n          \\\"name\\\": \\\"Help\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.openDocumentationUrl\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"k\\\",\\n          \\\"name\\\": \\\"Search keybindings\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.openGlobalKeybindings\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"p\\\",\\n          \\\"name\\\": \\\"Select theme\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.selectTheme\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"r\\\",\\n          \\\"name\\\": \\\"Quick open\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"t\\\",\\n          \\\"name\\\": \\\"Text\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.findInFiles\\\",\\n          \\\"args\\\": {\\n            \\\"query\\\": \\\"\\\",\\n            \\\"filesToInclude\\\": \\\"\\\",\\n            \\\"filesToExclude\\\": \\\"\\\",\\n            \\\"onlyOpenEditors\\\": false\\n          }\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"S\\\",\\n      \\\"name\\\": \\\"Show...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"d\\\",\\n          \\\"name\\\": \\\"Show debug console\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.debug.action.toggleRepl\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"o\\\",\\n          \\\"name\\\": \\\"Show output\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.action.output.toggleOutput\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"r\\\",\\n          \\\"name\\\": \\\"Show remote explorer\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.view.remote\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Show search\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.view.search\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"t\\\",\\n          \\\"name\\\": \\\"Show test\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.view.extension.test\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"t\\\",\\n      \\\"name\\\": \\\"Search text under cursor\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.findInFiles\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"T\\\",\\n      \\\"name\\\": \\\"Toggles...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"a\\\",\\n          \\\"name\\\": \\\"Toggle Activity Bar\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"settings.cycle\\\",\\n          \\\"args\\\": {\\n            \\\"id\\\": \\\"activityBar\\\",\\n            \\\"values\\\": [\\n              { \\\"workbench.activityBar.location\\\": \\\"hidden\\\" },\\n              { \\\"workbench.activityBar.location\\\": \\\"default\\\" }\\n            ]\\n          }\\n        },\\n        {\\n          \\\"key\\\": \\\"b\\\",\\n          \\\"name\\\": \\\"Toggle breadcrumbs\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"settings.cycle\\\",\\n          \\\"args\\\": {\\n            \\\"id\\\": \\\"breadcrumbs\\\",\\n            \\\"values\\\": [\\n              {\\n                \\\"breadcrumbs.enabled\\\": false\\n              },\\n              {\\n                \\\"breadcrumbs.enabled\\\": true\\n              }\\n            ]\\n          }\\n        },\\n        {\\n          \\\"key\\\": \\\"e\\\",\\n          \\\"name\\\": \\\"Toggle editor actions\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"settings.cycle\\\",\\n          \\\"args\\\": {\\n            \\\"id\\\": \\\"editorActions\\\",\\n            \\\"values\\\": [\\n              {\\n                \\\"workbench.editor.editorActionsLocation\\\": \\\"hidden\\\"\\n              },\\n              {\\n                \\\"workbench.editor.editorActionsLocation\\\": \\\"default\\\"\\n              }\\n            ]\\n          }\\n        },\\n        {\\n          \\\"key\\\": \\\"r\\\",\\n          \\\"name\\\": \\\"Toggle relative line numbers\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"vim.remap\\\",\\n          \\\"args\\\": {\\n            \\\"commands\\\": [\\n              {\\n                \\\"command\\\": \\\":set relativenumber!\\\"\\n              }\\n            ]\\n          }\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Toggle Sticky Scroll\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"settings.cycle\\\",\\n          \\\"args\\\": {\\n            \\\"id\\\": \\\"stickyScroll\\\",\\n            \\\"values\\\": [\\n              {\\n                \\\"editor.stickyScroll.enabled\\\": false\\n              },\\n              {\\n                \\\"editor.stickyScroll.enabled\\\": true\\n              }\\n            ]\\n          }\\n        },\\n        {\\n          \\\"key\\\": \\\"S\\\",\\n          \\\"name\\\": \\\"Toggle smooth scrolling\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"settings.cycle\\\",\\n          \\\"args\\\": {\\n            \\\"id\\\": \\\"smoothScrolling\\\",\\n            \\\"values\\\": [\\n              { \\\"editor.smoothScrolling\\\": false },\\n              { \\\"editor.smoothScrolling\\\": true }\\n            ]\\n          }\\n        },\\n        {\\n          \\\"key\\\": \\\"t\\\",\\n          \\\"name\\\": \\\"Toggle title bar\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"settings.cycle\\\",\\n          \\\"args\\\": {\\n            \\\"id\\\": \\\"titleBar\\\",\\n            \\\"values\\\": [\\n              {\\n                \\\"window.customTitleBarVisibility\\\": \\\"never\\\"\\n              },\\n              {\\n                \\\"window.customTitleBarVisibility\\\": \\\"auto\\\"\\n              }\\n            ]\\n          }\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"u\\\",\\n      \\\"name\\\": \\\"Undo Timeline Focus\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"timeline.focus\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"w\\\",\\n      \\\"name\\\": \\\"Window...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"c\\\",\\n          \\\"name\\\": \\\"Compare file with...\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.files.action.compareFileWith\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"x\\\",\\n      \\\"name\\\": \\\"Extensions\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.view.extensions\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"y\\\",\\n      \\\"name\\\": \\\"Sync...\\\",\\n      \\\"type\\\": \\\"bindings\\\",\\n      \\\"bindings\\\": [\\n        {\\n          \\\"key\\\": \\\"e\\\",\\n          \\\"name\\\": \\\"Export Settings\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.profiles.actions.exportProfile\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"i\\\",\\n          \\\"name\\\": \\\"Import Settings\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.profiles.actions.importProfile\\\"\\n        },\\n        {\\n          \\\"key\\\": \\\"s\\\",\\n          \\\"name\\\": \\\"Sync Settings Now\\\",\\n          \\\"type\\\": \\\"command\\\",\\n          \\\"command\\\": \\\"workbench.userDataSync.actions.syncNow\\\"\\n        }\\n      ]\\n    },\\n    {\\n      \\\"key\\\": \\\"z\\\",\\n      \\\"name\\\": \\\"Toggle zen mode\\\",\\n      \\\"type\\\": \\\"command\\\",\\n      \\\"command\\\": \\\"workbench.action.toggleZenMode\\\"\\n    }\\n  ],\\n\\n  // Explorer and files\\n  \\\"explorer.confirmDragAndDrop\\\": false,\\n  \\\"explorer.confirmDelete\\\": false,\\n  \\\"explorer.confirmPasteNative\\\": false,\\n  \\\"files.autoSave\\\": \\\"off\\\",\\n  \\\"files.trimTrailingWhitespace\\\": true,\\n  \\\"files.exclude\\\": {\\n    \\\"**/.classpath\\\": true,\\n    \\\"**/.project\\\": true,\\n    \\\"**/.settings\\\": true,\\n    \\\"**/.factorypath\\\": true\\n  },\\n\\n  // Search and diff\\n  \\\"search.seedOnFocus\\\": true,\\n  \\\"search.seedWithNearestWord\\\": true,\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n\\n  // Git and blame\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.replaceTagsWhenPull\\\": true,\\n  \\\"git-graph.showStatusBarItem\\\": false,\\n  \\\"git.blame.editorDecoration.enabled\\\": false,\\n\\n  // Integrated terminal\\n  \\\"terminal.integrated.fontFamily\\\": \\\"monospace\\\",\\n  \\\"terminal.integrated.scrollback\\\": 99999,\\n  \\\"terminal.integrated.fontSize\\\": 12,\\n  \\\"terminal.integrated.suggest.enabled\\\": true,\\n\\n  // Language tools and extensions\\n  \\\"todohighlight.isEnable\\\": false,\\n  \\\"notebook.cellToolbarLocation\\\": {\\n    \\\"default\\\": \\\"right\\\",\\n    \\\"jupyter-notebook\\\": \\\"left\\\"\\n  },\\n  \\\"python.insidersChannel\\\": \\\"off\\\",\\n  \\\"python.languageServer\\\": \\\"Pylance\\\",\\n  \\\"python.showStartPage\\\": false,\\n  \\\"python.terminal.activateEnvironment\\\": false,\\n  \\\"cmake.configureOnOpen\\\": true,\\n  \\\"claudeCode.preferredLocation\\\": \\\"sidebar\\\",\\n\\n  // Language-specific overrides\\n  \\\"[markdown]\\\": {\\n    \\\"editor.quickSuggestions\\\": {\\n      \\\"comments\\\": \\\"on\\\",\\n      \\\"strings\\\": \\\"on\\\",\\n      \\\"other\\\": \\\"on\\\"\\n    }\\n  },\\n  \\\"[cpp]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-vscode.cpptools\\\",\\n    \\\"editor.formatOnSave\\\": false,\\n    \\\"editor.formatOnPaste\\\": true\\n  },\\n  \\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-python.black-formatter\\\",\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"editor.tabSize\\\": 4,\\n    \\\"editor.formatOnSave\\\": false,\\n    \\\"editor.formatOnType\\\": true,\\n    \\\"editor.formatOnPaste\\\": true\\n  },\\n  \\\"[javascript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n  },\\n  \\\"[jsonc]\\\": {\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n  },\\n  \\\"[yaml]\\\": {\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.autoIndent\\\": \\\"advanced\\\",\\n    \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n  },\\n  \\\"[lua]\\\": {\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[html]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n  },\\n\\n  // Debugging\\n  \\\"launch\\\": {}\\n}\\n\"}",
  "keybindings": "{\"keybindings\": \"// VS Code actions and widget navigation live here; Vim editing sequences live in settings.json.\\n[\\n  // Return to an editable text editor; read-only and non-text pages need an untitled buffer.\\n  { \\\"key\\\": \\\"ctrl+;\\\", \\\"command\\\": \\\"workbench.action.focusActiveEditorGroup\\\" },\\n  {\\n    \\\"key\\\": \\\"ctrl+;\\\",\\n    \\\"command\\\": \\\"runCommands\\\",\\n    \\\"args\\\": {\\n      \\\"commands\\\": [\\n        \\\"workbench.action.files.newUntitledFile\\\",\\n        \\\"workbench.action.focusActiveEditorGroup\\\"\\n      ]\\n    },\\n    \\\"when\\\": \\\"activeEditorIsReadonly || (activeEditor != workbench.editors.files.textFileEditor && activeEditor != workbench.editors.textResourceEditor && !textCompareEditorActive && !sideBySideEditorActive)\\\"\\n  },\\n  // Leader menu; Insert mode and input widgets keep their normal Space key.\\n  {\\n    \\\"key\\\": \\\"space\\\",\\n    \\\"command\\\": \\\"whichkey.show\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && (vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine' || vim.mode == 'VisualBlock') && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n\\n  // Outline visibility is supplied to Which Key when its \\\"o\\\" binding is selected.\\n  {\\n    \\\"key\\\": \\\"o\\\",\\n    \\\"command\\\": \\\"whichkey.triggerKey\\\",\\n    \\\"args\\\": \\\"o\\\",\\n    \\\"when\\\": \\\"whichkeyVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"o\\\",\\n    \\\"command\\\": \\\"whichkey.triggerKey\\\",\\n    \\\"args\\\": { \\\"key\\\": \\\"o\\\", \\\"when\\\": \\\"outlineVisible\\\" },\\n    \\\"when\\\": \\\"whichkeyVisible && view.outline.visible\\\"\\n  },\\n\\n  // Relay Explorer visibility for leader e.\\n  {\\n    \\\"key\\\": \\\"e\\\",\\n    \\\"command\\\": \\\"whichkey.triggerKey\\\",\\n    \\\"args\\\": \\\"e\\\",\\n    \\\"when\\\": \\\"whichkeyVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"e\\\",\\n    \\\"command\\\": \\\"whichkey.triggerKey\\\",\\n    \\\"args\\\": { \\\"key\\\": \\\"e\\\", \\\"when\\\": \\\"explorerVisible\\\" },\\n    \\\"when\\\": \\\"whichkeyVisible && sideBarVisible && activeViewlet == 'workbench.view.explorer'\\\"\\n  },\\n\\n  // VS Code actions in Vim Normal mode.\\n  {\\n    \\\"key\\\": \\\"shift+h\\\",\\n    \\\"command\\\": \\\"workbench.action.previousEditorInGroup\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+l\\\",\\n    \\\"command\\\": \\\"workbench.action.nextEditorInGroup\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+;\\\",\\n    \\\"command\\\": \\\"vim.showQuickpickCmdLine\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+k\\\",\\n    \\\"command\\\": \\\"editor.action.showHover\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+,\\\",\\n    \\\"command\\\": \\\"workbench.action.previousEditor\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+.\\\",\\n    \\\"command\\\": \\\"workbench.action.nextEditor\\\",\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive && !suggestWidgetVisible\\\"\\n  },\\n\\n  // Explorer navigation must not intercept file-name input.\\n  { \\\"key\\\": \\\"ctrl+e\\\", \\\"command\\\": \\\"workbench.view.explorer\\\" },\\n  {\\n    \\\"key\\\": \\\"r\\\",\\n    \\\"command\\\": \\\"renameFile\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus && !explorerResourceIsRoot && !explorerResourceReadonly\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"j\\\",\\n    \\\"command\\\": \\\"list.focusDown\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"k\\\",\\n    \\\"command\\\": \\\"list.focusUp\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"enter\\\",\\n    \\\"command\\\": \\\"list.select\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"l\\\",\\n    \\\"command\\\": \\\"list.select\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"o\\\",\\n    \\\"command\\\": \\\"list.toggleExpand\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"h\\\",\\n    \\\"command\\\": \\\"list.collapse\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"a\\\",\\n    \\\"command\\\": \\\"explorer.newFile\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+a\\\",\\n    \\\"command\\\": \\\"explorer.newFolder\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n\\n  // Sidebar inputs allow pane navigation; pickers and completion lists keep priority.\\n  {\\n    \\\"key\\\": \\\"ctrl+h\\\",\\n    \\\"command\\\": \\\"workbench.action.navigateLeft\\\",\\n    \\\"when\\\": \\\"!inQuickOpen && !suggestWidgetVisible && (!inputFocus || editorTextFocus || terminalFocus || sideBarFocus || auxiliaryBarFocus)\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+j\\\",\\n    \\\"command\\\": \\\"workbench.action.navigateDown\\\",\\n    \\\"when\\\": \\\"!inQuickOpen && !suggestWidgetVisible && (