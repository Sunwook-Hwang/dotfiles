y while Codex is visible.\\n  { \\\"key\\\": \\\"ctrl+shift+1\\\", \\\"command\\\": \\\"chatgpt.openSidebar\\\" },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+1\\\",\\n    \\\"command\\\": \\\"workbench.action.closeAuxiliaryBar\\\",\\n    \\\"when\\\": \\\"view.chatgpt.sidebarSecondaryView.visible\\\"\\n  },\\n  { \\\"key\\\": \\\"ctrl+shift+t\\\", \\\"command\\\": \\\"chatgpt.openSidebar\\\" },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+t\\\",\\n    \\\"command\\\": \\\"workbench.action.closeAuxiliaryBar\\\",\\n    \\\"when\\\": \\\"view.chatgpt.sidebarSecondaryView.visible\\\"\\n  },\\n\\n  // Retain existing removals of conflicting default shortcuts.\\n  { \\\"key\\\": \\\"ctrl+e\\\", \\\"command\\\": \\\"-actions.findWithSelection\\\" },\\n  { \\\"key\\\": \\\"shift+ctrl+e\\\", \\\"command\\\": \\\"-workbench.view.explorer\\\" },\\n  {\\n    \\\"key\\\": \\\"enter\\\",\\n    \\\"command\\\": \\\"-renameFile\\\",\\n    \\\"when\\\": \\\"explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus\\\"\\n  },\\n  { \\\"key\\\": \\\"ctrl+j\\\", \\\"command\\\": \\\"-workbench.action.togglePanel\\\" },\\n  {\\n    \\\"key\\\": \\\"ctrl+k ctrl+i\\\",\\n    \\\"command\\\": \\\"-editor.action.showHover\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  { \\\"key\\\": \\\"ctrl+n\\\", \\\"command\\\": \\\"-workbench.action.files.newUntitledFile\\\" },\\n  { \\\"key\\\": \\\"ctrl+p\\\", \\\"command\\\": \\\"-workbench.action.quickOpen\\\" },\\n  {\\n    \\\"key\\\": \\\"ctrl+down\\\",\\n    \\\"command\\\": \\\"-selectNextSuggestion\\\",\\n    \\\"when\\\": \\\"suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+down\\\",\\n    \\\"command\\\": \\\"-showNextParameterHint\\\",\\n    \\\"when\\\": \\\"editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible\\\"\\n  },\\n  { \\\"key\\\": \\\"alt+cmd+b\\\", \\\"command\\\": \\\"-workbench