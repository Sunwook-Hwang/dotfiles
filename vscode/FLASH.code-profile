estion\\\",\\n    \\\"when\\\": \\\"textInputFocus && suggestWidgetVisible && !inQuickOpen && suggestWidgetMultipleSuggestions\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"tab\\\",\\n    \\\"command\\\": \\\"editor.action.inlineSuggest.commit\\\",\\n    \\\"when\\\": \\\"textInputFocus && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorTabMovesFocus && !suggestWidgetVisible && !inQuickOpen\\\"\\n  },\\n\\n  // Keep files open in one editor group; no hidden splits or Zen Mode.\\n  {\\n    \\\"key\\\": \\\"ctrl+w o\\\",\\n    \\\"command\\\": \\\"runCommands\\\",\\n    \\\"args\\\": {\\n      \\\"commands\\\": [\\n        \\\"workbench.action.closeSidebar\\\",\\n        \\\"workbench.action.closeAuxiliaryBar\\\",\\n        \\\"workbench.action.closePanel\\\",\\n        \\\"workbench.action.joinAllGroups\\\"\\n      ]\\n    },\\n    \\\"when\\\": \\\"editorTextFocus && vim.active && vim.mode == 'Normal' && !whichkeyActive\\\"\\n  },\\n\\n  // Terminal, save and layout shortcuts.\\n  { \\\"key\\\": \\\"ctrl+t\\\", \\\"command\\\": \\\"workbench.action.terminal.toggleTerminal\\\" },\\n  { \\\"key\\\": \\\"ctrl+\\\\\\\\\\\", \\\"command\\\": \\\"workbench.action.toggleMaximizedPanel\\\" },\\n  { \\\"key\\\": \\\"ctrl+s\\\", \\\"command\\\": \\\"workbench.action.files.save\\\" },\\n  // Resize the focused view; use separate axes inside the editor area.\\n  { \\\"key\\\": \\\"ctrl+shift+left\\\", \\\"command\\\": \\\"workbench.action.decreaseViewSize\\\" },\\n  { \\\"key\\\": \\\"ctrl+shift+right\\\", \\\"command\\\": \\\"workbench.action.increaseViewSize\\\" },\\n  { \\\"key\\\": \\\"ctrl+shift+up\\\", \\\"command\\\": \\\"workbench.action.decreaseViewSize\\\" },\\n  { \\\"key\\\": \\\"ctrl+shift+down\\\", \\\"command\\\": \\\"workbench.action.increaseViewSize\\\" },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+left\\\",\\n    \\\"command\\\": \\\"workbench.action.decreaseViewWidth\\\",\\n    \\\"when\\\": \\\"editorAreaFocus\\\"\\n  },\\n  {\\n   